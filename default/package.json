{
  "name": "%SERVICE_NAME",
  "version": "%SERVICE_VERSION",
  "description": "%SERVICE_DESCRIPTION",
  "keywords": [],
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run clean:compiled && tsc",
    "build:bundle": "rm -rf build && tsc -p tsconfig.build.json && cp -R bin build/bin",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=15000 $(find test -name '*.spec.js')",
    "test:unit": "npm run test",
    "test:coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage --test-timeout=15000 $(find test -name '*.spec.js')",
    "clean:dts": "find . -name '*.d.ts' -not -wholename '*node_modules*' -type f -delete",
    "clean:map": "find . -name '*.js.map' -not -wholename '*node_modules*' -type f -delete",
    "clean:js": "find . -name '*.js' -not -wholename '*node_modules*' -type f -delete",
    "clean:compiled": "npm run clean:js && npm run clean:dts && npm run clean:map",
    "clean:build": "rm -rf ./node_modules/@types ; find . -name '*.js.map' -type f -delete ; find . -name '*.ts' -type f -delete",
    "clean:test": "rm -rf coverage",
    "clean": "npm run clean:test && npm run clean:compiled",
    "start": "NODE_ENV=production /usr/bin/env node ./index.js LABEL=%SERVICE_NAME",
    "stop": "kill -s TERM $(ps aux | grep 'LABEL=%SERVICE_NAME' | awk '{print $2}')",
    "dev": "LABEL=%SERVICE_NAME node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "docker:build": "npm run build:bundle && docker build -f Dockerfile -t %SERVICE_NAME .",
    "docker:run": "docker run --rm -it --name %SERVICE_NAME %SERVICE_NAME",
    "docker:stop": "docker stop %SERVICE_NAME",
    "docker:ssh": "docker exec -it %SERVICE_NAME sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }, %SERVICE_REPO%SERVICE_BUGS%SERVICE_HOMEPAGE
  "author": "%SERVICE_AUTHOR_NAME %SERVICE_AUTHOR_EMAIL",
  "license": "%LICENSE_TAG",
  "dependencies": {
    "@imqueue/async-logger": "*",
    "@imqueue/rpc": "*",
    "reflect-metadata": "*",
    "typescript": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "husky": "*",
    "lint-staged": "*",
    "oxfmt": "*",
    "oxlint": "*",
    "tsx": "*"
  }
}
